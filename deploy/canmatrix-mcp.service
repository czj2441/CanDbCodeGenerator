[Unit]
Description=CanMatrix MCP Server - Streamable HTTP (PAT auth)
Documentation=https://github.com/your-org/CanDbCodeGenerator
After=network-online.target canmatrix-editor.service
Wants=network-online.target

[Service]
Type=simple

# ── 路径配置（部署时按实际路径修改）──
WorkingDirectory=/home/zijianchen1/CanDbCodeGenerator-mcp
# 后端地址（HTTP 端口 8080，与 canmatrix-editor.service 一致）
Environment=CANMATRIX_BACKEND_URL=http://127.0.0.1:8080
# 仅绑定本机回环地址，禁止直接暴露到公网；对外请走 HTTPS 反向代理
Environment=CANMATRIX_MCP_HOST=127.0.0.1
# 不能用 8081：后端 WS 端口 = 后端 HTTP 端口 +1（默认 8081），会与本服务监听端口冲突。
Environment=CANMATRIX_MCP_PORT=8082
ExecStart=/home/zijianchen1/CanDbCodeGenerator-mcp/venv/bin/python -m app.mcp

# ── 间隔自恢复 ──
Restart=always
RestartSec=5
TimeoutStopSec=15

# ── 日志输出 ──
StandardOutput=journal
StandardError=journal
SyslogIdentifier=canmatrix-mcp

[Install]
WantedBy=multi-user.target
