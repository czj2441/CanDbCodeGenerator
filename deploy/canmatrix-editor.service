[Unit]
Description=CanMatrix Editor - CAN Database Editor Service
Documentation=https://github.com/your-org/CanDbCodeGenerator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── 路径配置（部署时按实际路径修改）──
WorkingDirectory=/opt/canmatrix
# --auto-clean: 启动时自动终止旧进程（默认端口被占用时会拒绝启动）
# 说明：HTTP / WS / MCP 三元组在同一进程内启动（WS=+1、MCP=+2），无需单独的 MCP unit。
ExecStart=/opt/canmatrix/venv/bin/python -m app.server.lifecycle --host 0.0.0.0 --no-browser --auto-clean

# ── 间隔自恢复 ──
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# ── 日志输出 ──
StandardOutput=journal
StandardError=journal
SyslogIdentifier=canmatrix-editor

[Install]
WantedBy=multi-user.target
